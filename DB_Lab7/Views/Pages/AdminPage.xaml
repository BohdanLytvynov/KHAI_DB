<Page x:Class="DB_Lab7.Views.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DB_Lab7.Views.Pages"
      xmlns:vm="clr-namespace:DB_Lab7.ViewModels.Pages" 
      xmlns:system="clr-namespace:System;assembly=netstandard"
      xmlns:entity="clr-namespace:Data.Enums;assembly=Data"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"      
      d:DataContext="{d:DesignInstance vm:AdminPageViewModel, IsDesignTimeCreatable=True}">

    <Page.Resources>
        <system:Double x:Key="TabItemFontsize">25
        </system:Double>

        <ObjectDataProvider x:Key="entities" MethodName="GetValues"
                            ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="entity:EntityType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="10"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ComboBox IsEditable="True" 
                      ItemsSource="{Binding Source={StaticResource entities}}"  
                      Grid.Column="1"
                      SelectedIndex="0"
                      FontSize="16" Margin="0,2,0,0"/>
            <Grid Grid.Column="2" Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="610"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Get All" Style="{StaticResource Button}"
                            Width="90" Margin="20,0,0,0" FontSize="16"/>
                    <Button Content="Edit" Style="{StaticResource Button}"
                            Width="90" Margin="20,0,0,0" FontSize="16"/>
                    <Button Content="Delete" Style="{StaticResource Button}"
                            Width="90" Margin="20,0,0,0" FontSize="16"/>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Background="Gray">
                        <TextBox MinWidth="150" FontSize="16"
                                 Margin="0,0,10,0"/>
                        <Button Content="Search" Style="{StaticResource Button}"
                                Width="90" FontSize="16"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" x:Name="workPanel" Panel.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="85*"/>
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Style="{StaticResource GridSplitter_Vertical}"/>
            <ListView Grid.Column="2" Background="Transparent"/>
        </Grid>
        <DataGrid Grid.Row="2"/>
    </Grid>
</Page>
