<Page x:Class="DB_Lab7.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DB_Lab7.Views.Pages"
      xmlns:vm="clr-namespace:DB_Lab7.ViewModels.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage" Background="#FFD8D8D8"
      d:DataContext="{d:DesignInstance vm:MainPageViewModel, IsDesignTimeCreatable=True}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="67*"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <Button Width="150" Height="35"
                    Content="Get Tanks"
                    Style="{StaticResource Button}"
                    Margin="10,10"
                    Command="{Binding OnGetTanksButtonPressed}"
                    />

            <Button Width="150" Height="35" 
                    Content="Get My Tanks" 
                    Style="{StaticResource Button}"
                    Margin="10,10"
                    Command="{Binding OnGetMyTanksButtonPressed}"
                    />

            <Button Content="Buy" Width="100" Style="{StaticResource Button}"
        Margin="10,10" Height="35"
        Command="{Binding OnSelectTankButtonPressed}"/>

            <Button Content="Sell" Width="100" Height="35" Style="{StaticResource Button}"
                    Margin="10,10"
                    Command="{Binding OnSellButtonPressed}"
                    Visibility="{Binding SellButtonVisibility, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Orientation="Horizontal">
                <TextBox Width="400" Height="25" Margin="10,0"                         
                         ToolTip="{Binding ToolTipSearch, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TxtBoxInputStyle}"
                         FontSize="14"
                         >
                    <TextBox.Text>
                        <Binding Path="Search" UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding.ValidationRules>
                                <DataErrorValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <Button Content="Search" Width="100"
                            Style="{StaticResource Button}"
                            Height="25"
                    Margin="10,0"
                        Command="{Binding OnSearchButtonPressed}"/>
            </StackPanel>
        </WrapPanel>
        <GridSplitter Grid.Row="1"                        
                      Style="{StaticResource GridSplitter_Vertical}"/>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="34*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" HorizontalAlignment="Center"
                   Content="{Binding Inventory, UpdateSourceTrigger=PropertyChanged}" FontSize="20"
                   Foreground="Black" FontWeight="Bold"/>
            <DataGrid Grid.Row="2" 
          ItemsSource="{Binding Table, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
          AutoGenerateColumns="True"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectedIndex="{Binding SelectedDataRowIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        </Grid>
    </Grid>
</Page>
